// Vidya Database Schema
// Socratic AI Tutor

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// API KEY MANAGEMENT (for external integrations)
// ============================================

model ApiKey {
  id          String    @id @default(cuid())
  
  // Key identification
  key         String    @unique          // The hashed API key
  prefix      String                     // First 8 chars for identification (e.g., "vk_live_")
  name        String                     // Human-readable name (e.g., "PathWiz Production")
  
  // Ownership
  ownerEmail  String                     // Contact email for key owner
  ownerName   String                     // Organization or person name
  
  // Permissions & limits
  tier        ApiKeyTier @default(STANDARD)
  rateLimit   Int        @default(100)   // Requests per minute
  allowedOrigins String[]               // CORS origins this key can use
  
  // Stripe billing (metered overage)
  stripeCustomerId        String?
  stripeSubscriptionItemId String?
  
  // Status
  isActive    Boolean   @default(true)
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  
  // Usage tracking
  totalRequests Int     @default(0)
  
  // Relations
  sessions            Session[]
  usageRecords        UsageRecord[]
  stripeUsageReports  StripeUsageReport[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  @@index([key])
  @@index([ownerEmail])
  @@index([isActive])
}

enum ApiKeyTier {
  FREE        // 100 req/min, basic features
  STANDARD    // 500 req/min, all features
  PREMIUM     // 1000 req/min, priority processing
}

// ============================================
// ESSAY PROMPT KNOWLEDGE BASE
// ============================================

model School {
  id                  String            @id @default(cuid())
  name                String            // "Stanford University"
  slug                String            @unique  // "stanford"
  location            String?           // "Stanford, CA"
  selectivity         SchoolSelectivity @default(SELECTIVE)
  applicationPlatform String?           // "Common App", "Coalition", "UC App", "MIT Portal"
  acceptanceRate      Float?            // 0.03 = 3%
  websiteUrl          String?
  essayPageUrl        String?           // Direct link to essay prompt page

  prompts             EssayPrompt[]

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([slug])
  @@index([selectivity])
}

model EssayPrompt {
  id              String         @id @default(cuid())
  schoolId        String?
  school          School?        @relation(fields: [schoolId], references: [id])

  academicYear    String         // "2025-2026"
  promptText      String         @db.Text
  wordLimit       Int?           // null = no stated limit
  charLimit       Int?           // Some schools use character limits
  required        Boolean        @default(true)

  promptType      PromptType     @default(SUPPLEMENTAL)
  promptCategory  PromptCategory @default(OTHER)
  sortOrder       Int            @default(0)  // Display order within a school

  sourceType      PromptSource   @default(MANUAL)
  sourceUrl       String?
  verifiedAt      DateTime?

  sessions        Session[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([schoolId, academicYear])
  @@index([promptType])
  @@index([promptCategory])
  @@index([academicYear])
}

// ============================================
// USAGE TRACKING (per-API-key analytics)
// ============================================

model UsageRecord {
  id            String   @id @default(cuid())
  
  apiKeyId      String
  apiKey        ApiKey   @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  
  date          String   // "2026-02-07" — partition key for daily aggregation
  endpoint      String   // "/api/tutor/message", "/api/tutor/session/start", etc.
  
  requestCount  Int      @default(0)
  tokenEstimate Int      @default(0)  // Estimated total tokens used
  errorCount    Int      @default(0)
  overageCount  Int      @default(0)  // Requests that exceeded the rate limit (soft-limit overage)
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@unique([apiKeyId, date, endpoint])
  @@index([apiKeyId, date])
  @@index([date])
}

// ============================================
// STRIPE OVERAGE REPORTING (prevents double-reporting)
// ============================================

model StripeUsageReport {
  id                String   @id @default(cuid())

  apiKeyId          String
  apiKey            ApiKey   @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  date              String   // "2026-02-07" — the day whose overage was reported
  quantityReported  Int      // Total overage requests reported to Stripe for this day

  createdAt         DateTime @default(now())

  @@unique([apiKeyId, date])
  @@index([apiKeyId])
  @@index([date])
}

// ============================================
// USER & AUTHENTICATION
// ============================================

model User {
  id            String    @id @default(cuid())
  phone         String?   @unique  // Primary auth for India
  email         String?   @unique
  name          String?
  preferredLang Language  @default(EN)
  grade         Int?      // Class 11, 12, etc.
  targetExam    Exam?
  school        String?
  city          String?
  adaptiveState Json?     // { effectiveGrade: number, recentPerformance: QuestPerformance[], streakAtCurrentGrade: number }
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastActiveAt  DateTime  @default(now())
  
  sessions      Session[]
  progress      Progress[]
  
  gamification          UserGamification?
  badges                UserBadge[]
  xpEvents              XPEvent[]
  guardianOf            Guardian[]          @relation("GuardianUser")
  guardedBy             Guardian[]          @relation("GuardianStudent")
  taughtClassRooms      ClassRoom[]
  classRoomMemberships  ClassRoomStudent[]
  learningPaths         LearningPath[]
  
  @@index([phone])
  @@index([preferredLang])
}

// ============================================
// TUTORING SESSIONS
// ============================================

model Session {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Multi-tenancy: which API key created this session
  apiKeyId     String?
  apiKey       ApiKey?       @relation(fields: [apiKeyId], references: [id])

  subject      Subject
  topic        String?
  subtopic     String?
  language     Language      @default(EN)
  status       SessionStatus @default(ACTIVE)
  
  // Original problem/question
  problemText  String?
  problemImage String?       // URL to uploaded image
  conceptKey   String?       // Elementary: quest concept for mastery updates
  effectiveGrade Int?     // Adaptive: computed grade level for this session

  // Essay context (optional)
  essayType       String?
  essayPromptText String?     @db.Text
  wordLimit       Int?
  essayPromptId   String?
  essayPrompt     EssayPrompt? @relation(fields: [essayPromptId], references: [id])
  
  // Session metrics
  messageCount Int           @default(0)
  hintLevel    Int           @default(0)  // 0-5, current hint level (last seen)
  maxHintLevel Int           @default(0)  // 0-5, highest hint level reached this session
  resolved     Boolean       @default(false)
  noFinalAnswer Boolean      @default(false)  // Strict mode: no final answers
  
  // Learning outcomes
  conceptsUsed String[]      // Concepts student engaged with
  masteryGain  Float?        // Estimated learning gain
  
  // Session end report (generated on session completion)
  report       Json?         // { summary, strengths, areasForImprovement, nextSteps, ... }
  parentInsight String?      // One plain-language sentence for parents, e.g. "Your child explained why 3/4 > 2/3 using a pizza analogy"

  // Counselor context (multi-client support)
  clientContext  Json?        // Full client context (PathWiz: CounselorClientContext; ODEE: careerContext)
  clientUserId   String?      // Opaque client user ID for session grouping
  variant        String?      // Client variant: 'COLLEGE_US', 'CAREER_INDIA', etc.

  messages     Message[]
  
  startedAt    DateTime      @default(now())
  endedAt      DateTime?
  
  @@index([userId])
  @@index([subject])
  @@index([status])
  @@index([apiKeyId])
  @@index([clientUserId])
}

model Message {
  id          String      @id @default(cuid())
  sessionId   String
  session     Session     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  
  role        MessageRole
  content     String      @db.Text
  language    Language
  
  // Analysis metadata (for assistant messages)
  metadata    Json?       // { questionType, hintLevel, analysisResult, etc. }
  
  // Timing
  createdAt   DateTime    @default(now())
  
  @@index([sessionId])
  @@index([createdAt])
}

// ============================================
// LEARNING PROGRESS
// ============================================

model Progress {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  subject     Subject
  topic       String
  conceptId   String    // Reference to Concept
  
  mastery     Float     @default(0)  // 0-100 mastery score
  attempts    Int       @default(0)  // Times practiced
  successes   Int       @default(0)  // Times understood correctly
  
  lastSeen    DateTime  @default(now())
  nextReview  DateTime? // Spaced repetition scheduling
  
  @@unique([userId, conceptId])
  @@index([userId, subject])
  @@index([nextReview])
}

// ============================================
// EDUCATIONAL CONTENT
// ============================================

model Concept {
  id            String   @id @default(cuid())
  conceptKey    String?  @unique
  
  subject       Subject
  topic         String   // e.g., "Mechanics"
  subtopic      String?  // e.g., "Kinematics"
  
  // Multilingual names
  name          String   // English name
  nameHi        String?  // Hindi: हिंदी नाम
  nameKn        String?  // Kannada: ಕನ್ನಡ ಹೆಸರು
  
  // Multilingual descriptions
  description   String   @db.Text
  descriptionHi String?  @db.Text
  descriptionKn String?  @db.Text
  
  // Learning structure
  prerequisites String[] // IDs of prerequisite concepts
  difficulty    Int      @default(1) // 1-5
  gradeLevel    Int      @default(3)  // Grade level 3-9
  
  // 10x Content Seeding fields
  standard            String?                      // "CCSS.MATH.CONTENT.5.NF.A.1"
  misconceptionsData  Json?                        // [{ id, description, frequency }]
  relatedConcepts     Json?                        // [{ id, subject, relationship }]
  enrichmentTags      String[]   @default([])      // ["RSM-Level-4", "KUMON-E"]
  isDiagnostic        Boolean    @default(false)
  parentExplanation   String?    @db.Text          // 2-sentence parent-facing explanation
  source              String?                      // "seed-v1" for seeded content

  hints         Hint[]
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@index([subject, topic])
  @@index([isDiagnostic])
  @@index([source])
}

model Hint {
  id          String   @id @default(cuid())
  conceptId   String
  concept     Concept  @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  
  level       Int      // 1-5, progressively more helpful
  
  // Multilingual hint content
  content     String   @db.Text // English
  contentHi   String?  @db.Text // Hindi
  contentKn   String?  @db.Text // Kannada
  
  // Hint type
  type        HintType @default(CONCEPTUAL)
  
  @@unique([conceptId, level])
  @@index([conceptId])
}

model QuestionTemplate {
  id              String   @id @default(cuid())
  conceptKey      String
  gradeLevel      Int
  difficulty      Int      @default(1)
  subject         Subject  @default(MATHEMATICS)
  questionText    String   @db.Text
  answerFormula   String
  distractors     String[]
  solutionSteps   String[]
  tags            String[]
  source          String?
  misconceptions  Json?
  diagnostic      Boolean  @default(false)

  // 10x Content Seeding fields
  correctAnswer         String?                    // Explicit correct answer string
  distractorsStructured Json?                      // [{ text, misconceptionId }]
  hintsStructured       Json?                      // { level1_orient, level2_reframe, level3_structure, level4_targeted: { [miscId]: string }, level5_scaffold }
  explainBackPrompt     String?    @db.Text
  explainBackFollowUp   String?    @db.Text
  interestContexts      Json?                      // { gaming: "...", cooking: "...", ... }
  choiceCardFormat      Boolean    @default(true)
  seedSource            String?                    // "seed-v1"

  createdAt       DateTime @default(now())

  @@index([conceptKey, gradeLevel])
  @@index([subject, gradeLevel])
  @@index([diagnostic])
  @@index([seedSource])
}

// ============================================
// CONTENT ANALYTICS
// Deferred dashboard — tracked from session end hooks.
// Surface templates where >40% pick wrong distractor,
// or completion rate is <30%, after dogfood launch.
// ============================================

model TemplatePerformance {
  id                   String   @id @default(cuid())
  templateId           String   @unique
  attempts             Int      @default(0)
  correctCount         Int      @default(0)
  avgTimeMs            Float    @default(0)
  hintEscalationRate   Float    @default(0)
  distractorCounts     Json     @default("{}")
  lastUpdatedAt        DateTime @default(now()) @updatedAt

  @@index([templateId])
}

// ============================================
// QUEST MODELS
// ============================================

model Quest {
  id                String      @id @default(cuid())
  questKey          String?     @unique              // "quest-math-kitchen-lab-g5-001"
  
  subject           Subject
  title             String
  description       String      @db.Text
  gradeLevel        Int
  chapter           String?
  theme             String?                          // "Space Explorer", "Kitchen Lab"
  interestTags      String[]    @default([])
  narrative         String?     @db.Text
  
  // Content references (stored as string arrays of conceptKeys / template IDs)
  conceptKeys       String[]    @default([])         // concept keys covered
  templateIds       String[]    @default([])         // template IDs in this quest
  
  questType         QuestType   @default(TEACH)
  difficultyBand    Json?                            // { min, max, curve }
  reasoningArc      Json?                            // { steps: [activate, introduce, challenge, transfer, articulate] }
  estimatedMinutes  Int?
  problemCount      Int         @default(6)
  
  // Cross-subject quest data
  crossSubjectData  Json?                            // { subjects, stages, thinkingSkill, crossLinkReflection }
  
  // Metadata
  seedSource        String?                          // "seed-v1"
  isActive          Boolean     @default(true)
  
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  
  @@index([subject, gradeLevel])
  @@index([questType])
  @@index([theme])
  @@index([seedSource])
  @@index([isActive])
}

model DiagnosticQuest {
  id              String    @id @default(cuid())
  subject         Subject
  gradeBand       String                            // "3-4", "5-6", "7-8", "9"
  title           String
  description     String    @db.Text
  
  stages          Json                              // [{ questionNumber, conceptId, templateId, skipToIfCorrect, skipToIfWrong }]
  placementLogic  Json                              // [{ correctRange, placementConceptKey, placementGrade }]
  
  seedSource      String?                           // "seed-v1"
  isActive        Boolean   @default(true)
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  @@unique([subject, gradeBand])
  @@index([subject])
  @@index([isActive])
}

// ============================================
// DOGFOOD ANALYTICS
// Lightweight append-only event log for 10-family dogfood.
// Provides session completion rate, explain-back rate,
// D1/D7 return, hint escalation, and subject diversity KPIs.
// Fire-and-forget: never blocks a request.
// ============================================

model AnalyticsEvent {
  id         String   @id @default(cuid())
  userId     String
  sessionId  String?
  event      String
  properties Json     @default("{}")
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([event])
  @@index([createdAt])
  @@index([sessionId])
}

// ============================================
// LEARNER MODEL (Grade 4-5 math, first-class)
// The system's model of the student. Five layers:
//   1. Knowledge state      -> Progress (exists)
//   2. Misconception ledger -> Misconception + MisconceptionState
//   3. Learning channel      -> LearnerTraits.channelWeights
//   4. Struggle/affect       -> LearnerTraits.struggleTolerance / frustrationProneness
//   5. Habits of mind        -> LearnerTraits.habits
// LearnerEvent is the append-only telemetry spine that feeds all of the above.
// ============================================

/// Append-only, queryable per-turn telemetry. Captures the structured signals
/// the engine computes each turn (and previously discarded into Message.metadata
/// and the fire-and-forget AnalyticsEvent). This is the spine the learner model
/// is rolled up from. No FK relation (mirrors AnalyticsEvent) so writes never
/// block the request path.
model LearnerEvent {
  id                  String           @id @default(cuid())
  userId              String
  sessionId           String?
  conceptKey          String?
  templateId          String?
  ts                  DateTime         @default(now())

  kind                LearnerEventKind

  // Typed signal columns (nullable — not every kind populates every column)
  correct             Boolean?
  distanceFromSolution Float?
  errorType           String?          // 'conceptual' | 'computational' | 'approach' | 'none'
  errorDescription    String?          @db.Text
  misconceptionId     String?          // resolved Misconception.id when inferred
  hintLevel           Int?
  latencyMs           Int?
  representation      String?          // 'manipulative' | 'visual' | 'symbolic' | 'story'

  payload             Json?            // small overflow for kind-specific extras

  @@index([userId, conceptKey])
  @@index([userId, ts])
  @@index([sessionId])
  @@index([kind])
}

/// Content catalog of named misconceptions (promoted from Concept.misconceptionsData
/// and QuestionTemplate.misconceptions). Detection cues live in `signature`,
/// remediation guidance in `remediation`.
model Misconception {
  id            String   @id @default(cuid())
  key           String   @unique          // stable slug, e.g. "add_denominators"
  conceptKey    String
  subject       Subject  @default(MATHEMATICS)
  gradeLevel    Int      @default(4)

  description   String   @db.Text         // kid-neutral description of the error
  parentLabel   String?                   // parent-friendly phrasing, e.g. "added the bottoms of fractions"

  signature     Json?                     // { distractorIndices?: number[], errorType?, keywords?: string[] }
  remediation   Json?                     // { representation, hintLadder?: string[], reframe? }

  source        String?                   // "seed-v1"

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  states        MisconceptionState[]

  @@index([conceptKey])
  @@index([subject, gradeLevel])
}

enum MisconceptionStatus {
  ACTIVE      // observed, not yet being remediated
  RESOLVING   // student is producing correct work against this target
  RESOLVED    // N consecutive correct — cleared
}

/// Per-student ledger of which misconceptions a child holds and their lifecycle.
model MisconceptionState {
  id                String              @id @default(cuid())
  userId            String
  misconceptionId   String
  misconception     Misconception       @relation(fields: [misconceptionId], references: [id], onDelete: Cascade)

  status            MisconceptionStatus @default(ACTIVE)
  observations      Int                 @default(1)
  consecutiveCorrect Int                @default(0)  // toward RESOLVING -> RESOLVED

  firstObservedAt   DateTime            @default(now())
  lastObservedAt    DateTime            @default(now())
  resolvedAt        DateTime?

  @@unique([userId, misconceptionId])
  @@index([userId, status])
}

/// Slow-moving model of the learner: how they learn (channel), how they struggle,
/// and their habits of mind. One row per user. Updated by the session-end rollup.
model LearnerTraits {
  id                   String   @id @default(cuid())
  userId               String   @unique

  // Learning-channel model — relative weight of each representation in this kid's breakthroughs.
  channelWeights       Json     @default("{}")   // { manipulative, visual, symbolic, story } each ~0..1

  // Struggle / affect model
  struggleTolerance    Float    @default(0.5)    // 0..1; higher = give them longer before a hint
  frustrationProneness Float    @default(0.5)    // 0..1; higher = de-escalate faster
  optimalSessionMinutes Int?

  // Habits of mind — the anti-score feedback currency.
  // { persistence: {score,trend}, patternSeeking: {...}, precision, selfCorrection, explanation }
  habits               Json     @default("{}")

  lastRollupAt         DateTime?
  createdAt            DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

/// Teachable-agent projection of the learner model. The buddy "knows" what the
/// child has taught it (mirrors mastery for taught concepts) and remembers
/// explain-back moments for callbacks.
model BuddyState {
  id               String   @id @default(cuid())
  userId           String   @unique

  conceptKnowledge Json     @default("{}")   // { [conceptKey]: { mastery, lastTaughtAt } }
  taughtMoments    Json     @default("[]")   // [{ conceptKey, summary, at }]

  level            Int      @default(1)
  cosmetic         Json     @default("{}")

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

enum LearnerEventKind {
  ATTEMPT
  HINT_ESCALATED
  CHOICE_SELECTED
  EXPLAIN_BACK
  BREAKTHROUGH
  STALL
  ABANDON
}

// ============================================
// GAMIFICATION
// ============================================

model UserGamification {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  xp              Int      @default(0)
  level           Int      @default(1)
  currentStreak   Int      @default(0)
  longestStreak   Int      @default(0)
  lastActiveDate  String?
  streakFreezes   Int      @default(0)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([xp])
  @@index([currentStreak])
}

model UserBadge {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge     BadgeType
  earnedAt  DateTime  @default(now())
  
  @@unique([userId, badge])
  @@index([userId])
}

model XPEvent {
  id         String      @id @default(cuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId  String?
  eventType  XPEventType
  xpAmount   Int
  createdAt  DateTime    @default(now())
  
  @@index([userId, createdAt])
}

// ============================================
// LEARNING PATHS
// ============================================

model LearningPath {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject        Subject
  
  pathSteps      Json
  completionPct  Float    @default(0)
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  @@unique([userId, subject])
  @@index([userId])
}

// ============================================
// GUARDIAN / CLASSROOM (Parent/Teacher Dashboard)
// ============================================

model Guardian {
  id              String       @id @default(cuid())
  userId          String
  user            User         @relation("GuardianUser", fields: [userId], references: [id])
  studentUserId   String
  student         User         @relation("GuardianStudent", fields: [studentUserId], references: [id])
  relationship    GuardianRole
  approved        Boolean      @default(false)
  
  createdAt       DateTime     @default(now())
  
  @@unique([userId, studentUserId])
  @@index([studentUserId])
}

model ClassRoom {
  id          String             @id @default(cuid())
  teacherId   String
  teacher     User               @relation(fields: [teacherId], references: [id])
  name        String
  joinCode    String             @unique
  
  students    ClassRoomStudent[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ClassRoomStudent {
  id          String    @id @default(cuid())
  classRoomId String
  classRoom   ClassRoom @relation(fields: [classRoomId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  joinedAt    DateTime  @default(now())
  
  @@unique([classRoomId, userId])
}

// ============================================
// ENUMS
// ============================================

enum Language {
  EN  // English
  HI  // Hindi (हिंदी)
  KN  // Kannada (ಕನ್ನಡ)
  FR  // French (Français)
  DE  // German (Deutsch)
  ES  // Spanish (Español)
  ZH  // Mandarin Chinese (中文)
}

enum Subject {
  PHYSICS
  CHEMISTRY
  MATHEMATICS
  BIOLOGY
  ESSAY_WRITING
  COUNSELING
  CODING
  ENGLISH_LITERATURE
  ECONOMICS
  AI_LEARNING
  LOGIC
  ML_CONCEPTS        // NEW
  ENGLISH_READING    // NEW
}

enum Exam {
  BOARDS_CBSE
  BOARDS_ICSE
  BOARDS_STATE
}

enum SessionStatus {
  ACTIVE
  COMPLETED
  ABANDONED
  PAUSED
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum HintType {
  CONCEPTUAL    // Points to relevant concept
  PROCEDURAL    // Suggests approach/method
  EXAMPLE       // Similar worked example
  VISUAL        // Diagram or visualization hint
  FORMULA       // Relevant formula reminder
  ORIENT        // Level 1: activates prior knowledge
  REFRAME       // Level 2: new perspective on the problem
  STRUCTURE     // Level 3: breaks problem into steps
  TARGET        // Level 4: addresses specific misconception
  SCAFFOLD      // Level 5: near-solution structure
}

enum SchoolSelectivity {
  MOST_SELECTIVE    // < 10% acceptance
  HIGHLY_SELECTIVE  // 10-25%
